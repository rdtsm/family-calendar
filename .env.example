# Local development only. On Cloudflare these are set with `wrangler secret put`,
# and the database is the D1 binding rather than a file.

# 6-digit PIN the parent types to unlock the planning screen
PARENT_PIN=246810

# Run `npm run keys` to generate these
SESSION_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Optional
# Where the bare domain sends visitors. Unset, "/" serves the parent app.
ROOT_REDIRECT_URL=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_FAMILY_TZ=Europe/London
REMINDER_LEAD_MINUTES=30
DIGEST_HOUR=7
SQLITE_PATH=.data/family.sqlite
